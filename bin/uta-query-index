#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UTA_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
DEFAULT_REPO="${PWD}"
HAS_REPO=0

for arg in "$@"; do
  case "${arg}" in
    --repo|--repo=*)
      HAS_REPO=1
      ;;
  esac
done

export PYTHONPATH="${UTA_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
PYTHON_BIN="${UTA_PYTHON_BIN:-}"
if [[ -z "${PYTHON_BIN}" && -x "${UTA_ROOT}/.venv/bin/python" ]]; then
  PYTHON_BIN="${UTA_ROOT}/.venv/bin/python"
fi
if [[ -z "${PYTHON_BIN}" ]]; then
  PYTHON_BIN="python3"
fi

if [[ "${HAS_REPO}" -eq 1 ]]; then
  exec "${PYTHON_BIN}" -m uta.cli query-index "$@"
fi

exec "${PYTHON_BIN}" -m uta.cli query-index --repo "${DEFAULT_REPO}" "$@"
